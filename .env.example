# GitHub
GITHUB_PERSONAL_ACCESS_TOKEN=PASTE_YOUR_GITHUB_TOKEN_HERE
GITHUB_OWNER=MicrosoftDocs
GITHUB_REPO=dynamics-365-unified-operations-public
GITHUB_FOLDER=articles/commerce/b2b
GITHUB_BRANCH=main

# Local GitHub MCP executable
MCP_EXE=C:\Users\parin\go\bin\github-mcp-server.exe

# Ollama
# Use your actual Ollama host, for example:
# OLLAMA_URL=https://your-ollama-host
# or:
# OLLAMA_URL=https://your-ollama-host/api/generate
OLLAMA_URL=
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=300

# Search/source limits
SEARCH_PASSES=3
MAX_SEARCH_QUERIES=12
MAX_SEARCH_RESULTS_PER_QUERY=30
MAX_SOURCE_CHARS=180000
